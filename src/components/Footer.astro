---
import Dial from './Dial.astro';
---

<footer class="container-ad w-full mt-24 sm:mt-40 pb-12">
  <div class="rule pt-8 grid-ad gap-y-6">
    <p class="font-serif italic text-ink-2 [grid-column:1/7]">Thanks for reading.</p>
    <div class="[grid-column:7/13] flex flex-col gap-6">
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-display font-medium text-[11px] uppercase tracking-[0.08em]">
        <a class="link" href="https://github.com/Snazzyham" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="link" href="https://calendar.app.google/W5EZnqFQEZhZ99zU9" target="_blank" rel="noopener noreferrer">Book a call</a>
        <a class="link" href="/rss.xml" data-astro-reload>RSS</a>
        <a class="link" href="/llms.txt" data-astro-reload>llms.txt</a>
      </div>
      <div class="flex items-center gap-3 font-display font-medium text-[11px] uppercase tracking-[0.08em] text-ink-2">
        <Dial />
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</footer>
