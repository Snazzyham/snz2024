---
interface Props {
  photos: { src: string; caption?: string }[];
}

const { photos } = Astro.props;
---

<div
  id="lightbox"
  class="lightbox"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  data-photos={JSON.stringify(photos)}
>
  <button id="lightbox-close" type="button" class="lb-btn lb-close" aria-label="Close">
    Close ×
  </button>
  <button id="lightbox-prev" type="button" class="lb-btn lb-prev" aria-label="Previous">
    ← Prev
  </button>
  <button id="lightbox-next" type="button" class="lb-btn lb-next" aria-label="Next">
    Next →
  </button>
  <figure class="lb-figure">
    <img id="lightbox-img" src="" alt="" class="vintage" />
    <figcaption class="lb-caption">
      <span id="lightbox-caption"></span>
      <span id="lightbox-counter"></span>
    </figcaption>
  </figure>
</div>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    color: var(--ink);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
  .lb-figure {
    margin: 0;
    max-width: 100%;
  }
  .lb-figure img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }
  .lb-caption {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .lb-btn {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .lb-btn:hover {
    color: var(--accent);
  }
  .lb-close { top: clamp(1rem, 3vw, 2rem); right: clamp(1.25rem, 4vw, 3rem); }
  .lb-prev { bottom: clamp(1rem, 3vw, 2rem); right: calc(clamp(1.25rem, 4vw, 3rem) + 5rem); }
  .lb-next { bottom: clamp(1rem, 3vw, 2rem); right: clamp(1.25rem, 4vw, 3rem); }
  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox.is-open { transition: none; }
  }
</style>

<script>
  type Photo = { src: string; caption?: string };
  let index = 0;

  const root = () => document.getElementById('lightbox');
  const photos = (): Photo[] => {
    try {
      return JSON.parse(root()?.dataset.photos ?? '[]');
    } catch {
      return [];
    }
  };
  const isOpen = () => root()?.classList.contains('is-open') ?? false;

  function render() {
    const list = photos();
    const p = list[index];
    if (!p) return;
    (document.getElementById('lightbox-img') as HTMLImageElement).src = p.src;
    document.getElementById('lightbox-caption')!.textContent = p.caption ?? '';
    document.getElementById('lightbox-counter')!.textContent =
      `${String(index + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
  }
  function open(i: number) {
    index = i;
    render();
    const el = root()!;
    el.classList.add('is-open');
    el.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    const el = root();
    if (!el) return;
    el.classList.remove('is-open');
    el.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  function step(d: number) {
    const n = photos().length;
    if (!n) return;
    index = (index + d + n) % n;
    render();
  }

  // Document-level handler registered once; survives ClientRouter swaps.
  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  document.addEventListener('astro:page-load', () => {
    const el = root();
    if (!el) return;
    document.querySelectorAll<HTMLElement>('[data-lightbox-index]').forEach((t) => {
      t.addEventListener('click', () => open(Number(t.dataset.lightboxIndex)));
    });
    document.getElementById('lightbox-close')!.addEventListener('click', close);
    document.getElementById('lightbox-prev')!.addEventListener('click', () => step(-1));
    document.getElementById('lightbox-next')!.addEventListener('click', () => step(1));
    el.addEventListener('click', (e) => {
      if (e.target === el) close();
    });
  });

  document.addEventListener('astro:before-swap', () => {
    document.body.style.overflow = '';
  });
</script>
