---
import siteConfig from '../data/site-config';
---

<header class="w-full max-w-3xl mx-auto mb-16 sm:mb-24 text-center">
    {
        siteConfig.logo && siteConfig.logo?.src ? (
            <a href="/" class="inline-block hover:opacity-80 transition-opacity">
                <img src={siteConfig.logo.src} alt={siteConfig.logo.alt || ''} class="max-h-12 mx-auto" />
            </a>
        ) : (
            <a class="font-heading text-4xl leading-tight font-black tracking-tighter sm:text-6xl" href="/">
                {siteConfig.title}
            </a>
        )
    }
    {siteConfig.subtitle && <p class="text-xs uppercase tracking-widest mt-4 opacity-60 font-medium">{siteConfig.subtitle}</p>}
    <div class="h-px w-12 bg-main mx-auto mt-8 opacity-20"></div>
</header>
