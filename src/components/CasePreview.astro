---
const { clientLogo, title, client, blurb, primary, secondary, slug } = Astro.props;

type Props = {
  client: string;
  clientLogo: string;
  title: string;
  blurb: string;
  primary: string;
  secondary: string;
  slug: string;
};
---

<a href={`/case/${slug}`} class="group block w-full">
  <div class="relative aspect-[4/5] overflow-hidden rounded-sm bg-muted transition-all duration-500 group-hover:shadow-xl" style={{ backgroundColor: secondary }}>
    <div class="absolute inset-0 flex items-center justify-center p-12 transition-transform duration-700 group-hover:scale-110">
      <img src={clientLogo} alt={client} class="w-24 h-24 object-contain rounded-full sm:w-32 sm:h-32 shadow-lg" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
  </div>
  
  <div class="mt-6 text-center">
    <p class="text-[10px] uppercase tracking-[0.25em] font-bold opacity-40 mb-2">
      {client}
    </p>
    <h3 class="font-heading text-2xl tracking-tight leading-tight group-hover:opacity-70 transition-opacity">
      {title}
    </h3>
    {blurb !== '-' && <p class="text-xs italic mt-2 opacity-60 font-light">{blurb}</p>}
  </div>
</a>
