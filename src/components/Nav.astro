---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
---

<header class="container-ad w-full">
  <nav
    class="flex flex-col gap-3 py-5 border-b border-rule sm:flex-row sm:items-baseline sm:justify-between"
  >
    <a href="/" class="font-display font-semibold text-[18px] tracking-tight">Soham Adwani</a>
    <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 font-display font-medium text-[11px] uppercase tracking-[0.08em]">
      {navLinks.map((link) => <NavLink href={link.href}>{link.text}</NavLink>)}
      <NavLink href="/bench/" target="_blank" rel="noopener">Bench ↗</NavLink>
      <ThemeToggle />
    </div>
  </nav>
</header>
