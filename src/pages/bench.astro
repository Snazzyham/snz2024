---
import BaseLayout from '../layouts/BaseLayout.astro';
import bench from '../data/bench.json';
import { author, breadcrumbs, webPage } from '../utils/schema';
import {
  DEFAULT_SORT,
  band,
  bestOf,
  chartSvg,
  clientTracks,
  esc,
  pickHtml,
  rowsHtml,
  short,
  sortRows,
  theadHtml,
  topOf
} from '../lib/bench';

// bench.json is generated by public_data() in OtterBench's bench.py; never edit it here.
const { meta, copy, thinking } = bench;
const rate = bench.default_rate;
const tracks = clientTracks(bench.tracks);
const about = new Map(bench.tracks.map((t) => [t.id, t]));
const models = Object.entries(bench.models);
const gradeBand: Record<string, string> = { A: 'b95', B: 'b85', C: 'b75', D: 'b60', F: 'b0' };
const linked = (s: string) =>
  esc(s)
    .replace('Forge', '<a class="link" href="https://toolsbyforge.com">Forge</a>')
    .replace('Otterdev', '<a class="link" href="https://otterdev.io">Otterdev</a>');

const schema = [
  webPage('WebPage', '/bench/', meta.title, meta.description, {
    author,
    dateModified: meta.last_run,
    mainEntity: { '@id': `${meta.url}#dataset` }
  }),
  {
    '@type': 'Dataset',
    '@id': `${meta.url}#dataset`,
    name: meta.title,
    description: meta.dataset_description,
    url: meta.url,
    creator: author,
    isAccessibleForFree: true,
    inLanguage: 'en',
    dateModified: meta.last_run,
    temporalCoverage: `${meta.first_run}/${meta.last_run}`,
    variableMeasured: [
      { '@type': 'PropertyValue', name: 'Score', minValue: 0, maxValue: 100 },
      { '@type': 'PropertyValue', name: 'Cost', unitText: 'USD' },
      { '@type': 'PropertyValue', name: 'Wall-clock time', unitText: 'seconds' },
      { '@type': 'PropertyValue', name: 'Tokens' }
    ],
    measurementTechnique: 'Fixed tasks graded by an answer key and a single LLM judge'
  },
  breadcrumbs([{ name: meta.title, path: new URL(meta.url).pathname }])
];
---

<BaseLayout title={meta.title} description={meta.description} schema={schema}>
  <div class="bench container-main pt-12 pb-24 sm:pt-20">
    <header class="mb-12">
      <p class="eyebrow mb-4">Updated {meta.last_run} <span class="text-accent">—</span> since {meta.first_run}</p>
      <h1 class="headline">{meta.title}</h1>
      <p class="standfirst mt-6 max-w-3xl">{meta.description}</p>
      <p class="mt-6 max-w-3xl text-[15px] text-ink-2">
        {copy.intro} Click a row for task scores, dates and source runs; click a column header to sort.
      </p>
    </header>

    <section class="summary" aria-label="Track summary">
      {
        tracks.map((t) => {
          const top = topOf(t.rows);
          return (
            <a class="sumcard" href={`#track-${t.id}`} data-track={t.id}>
              <span class="eyebrow">{t.name}</span>
              <span class="sumtop">
                <span class="grade" data-band={band(top ? top.score : null)}>
                  {top ? top.score!.toFixed(1) : '—'}
                </span>
                {top && <span class="model">{short(top.model)}</span>}
              </span>
              {t.pick && (
                <span class="sumpick">
                  <span class="lbl">Best value</span>
                  <span class="pickval" set:html={pickHtml(bestOf(t.rows, rate), rate)} />
                </span>
              )}
            </a>
          );
        })
      }
    </section>

    <div class="controls">
      <div id="picks" class="picks" aria-label="Filter by model">
        {
          models.map(([m, lv]) => (
            <button type="button" data-model={m} aria-pressed="false">
              <span class="model">{short(m)}</span>
              {lv.length > 1 && <span class="count">{lv.length}</span>}
            </button>
          ))
        }
        <button type="button" id="clear" class="clear" hidden>Show all</button>
      </div>
      <div id="levels" class="levels"></div>
      <label class="q">
        <span class="sr-only">Filter rows</span>
        <input id="q" type="search" placeholder="Filter by model, thinking, date or run" autocomplete="off" />
      </label>
    </div>

    <div class="ratebox">
      <label class="rate">
        <span>Effective token rate</span>
        <input id="rate" type="range" min="0.05" max="0.35" step="0.01" value={rate} />
        <strong id="rateval" class="mono">${rate.toFixed(2)}</strong><span class="muted">/ min</span>
      </label>
      <label class="only"><input id="onlybest" type="checkbox" /> Show only the Best value pick in each track</label>
    </div>
    <p class="ratehelp">{copy.rate_help}</p>

    {
      tracks.map((t) => {
        const a = about.get(t.id)!;
        const best = bestOf(t.rows, rate);
        return (
          <section class="track rule" id={`track-${t.id}`} data-track={t.id}>
            <div class="trackhead">
              <div>
                <h2 class="headline-sm">{t.name}</h2>
                <p class="what">{a.what}</p>
                <details class="tasks">
                  <summary>What the tasks check</summary>
                  <ul>
                    {a.tasks.map((k) => (
                      <li>
                        <span class="mono">{k.id}</span> {k.description}
                      </li>
                    ))}
                  </ul>
                </details>
              </div>
              <figure class="chart" set:html={chartSvg(t.rows, best, rate)} />
            </div>
            <div class="table-scroll">
              <table>
                <thead set:html={theadHtml(DEFAULT_SORT)} />
                <tbody set:html={rowsHtml(sortRows(t.rows, DEFAULT_SORT, rate), best, rate, t.multi, new Set())} />
              </table>
            </div>
            {t.pick && <p class="legend">{copy.value_legend}</p>}
          </section>
        );
      })
    }

    <section class="track rule" id="thinking">
      <h2 class="headline-sm">{thinking.title}</h2>
      <p class="what">{thinking.description}</p>
      <details class="tasks">
        <summary>Rubric</summary>
        <ul>
          {
            thinking.rubric.map((g) => (
              <li>
                <span class="mono">{g.grade}</span> {g.text}
              </li>
            ))
          }
        </ul>
        <p class="method">{thinking.method}</p>
      </details>
      <div class="table-scroll">
        <table class="slop">
          <thead>
            <tr><th scope="col">Model</th><th scope="col" class="num">Grade</th><th scope="col" class="date">Run</th></tr>
          </thead>
          <tbody>
            {
              thinking.rows.map((r) => (
                <tr class="srow" data-model={r.model} data-thinking={r.thinking} data-text={`${r.model} ${r.thinking} ${r.date} ${r.source_run}`.toLowerCase()}>
                  <td data-label="Model">
                    <span class="model">{r.model}</span>
                    <span class="think">{r.thinking}</span>
                  </td>
                  <td class="num" data-label="Grade">
                    <span class="gpill" data-band={r.grade ? gradeBand[r.grade] : 'none'}>{r.label}</span>
                  </td>
                  <td class="date" data-label="Run">{r.date}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {thinking.rows.some((r) => r.no_reasoning) && <p class="legend">{copy.no_reasoning}</p>}
    </section>

    <footer class="benchfoot rule">
      {copy.footer.map((p, i) => <p class:list={[i === 0 && 'blurb']} set:html={linked(p)} />)}
    </footer>
  </div>

  <script type="application/json" id="bench-data" set:html={JSON.stringify({ rate, tracks, levels: bench.models }).replace(/</g, '\\u003c')} />
</BaseLayout>

<script>
  import {
    DEFAULT_SORT,
    bestOf,
    chartSvg,
    esc,
    pickHtml,
    rowsHtml,
    short,
    sortRows,
    theadHtml,
    type Row,
    type Sort,
    type SortKey,
    type Track
  } from '../lib/bench';

  type Data = { rate: number; tracks: Track[]; levels: Record<string, string[]> };

  function init() {
    const el = document.getElementById('bench-data');
    if (!el) return;
    const data = JSON.parse(el.textContent!) as Data;
    const picks = new Map<string, Set<string>>();
    const sorts = new Map<string, Sort>();
    const open = new Map<string, Set<string>>();
    let rate = data.rate;
    let q = '';
    let onlyBest = false;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const shown = (model: string, thinking: string, text: string) =>
      (!picks.size || (picks.has(model) && (!picks.get(model)!.size || picks.get(model)!.has(thinking)))) &&
      (!q || text.includes(q));

    function renderTrack(t: Track) {
      const section = $<HTMLElement>('track-' + t.id);
      const best = bestOf(t.rows, rate);
      const sort = sorts.get(t.id) ?? DEFAULT_SORT;
      let rows: Row[] = t.rows.filter((r) =>
        shown(r.model, r.thinking, `${r.model} ${r.thinking} ${r.date} ${r.run}`.toLowerCase())
      );
      if (onlyBest) rows = best ? [best] : [];
      section.hidden = onlyBest && !best;
      section.querySelector('thead')!.innerHTML = theadHtml(sort);
      section.querySelector('tbody')!.innerHTML = rowsHtml(sortRows(rows, sort, rate), best, rate, t.multi, open.get(t.id) ?? new Set());
      section.querySelector('.chart')!.innerHTML = chartSvg(rows, best, rate);
      const pick = document.querySelector(`.sumcard[data-track="${t.id}"] .pickval`);
      if (pick) pick.innerHTML = pickHtml(best, rate);
    }

    function renderAll() {
      data.tracks.forEach(renderTrack);
      document.querySelectorAll<HTMLTableRowElement>('tr.srow').forEach((tr) => {
        tr.hidden = !shown(tr.dataset.model!, tr.dataset.thinking!, tr.dataset.text!);
      });
    }

    function syncPicks() {
      document.querySelectorAll<HTMLButtonElement>('#picks button[data-model]').forEach((b) => {
        const on = picks.has(b.dataset.model!);
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      $('levels').innerHTML = [...picks.keys()]
        .filter((m) => data.levels[m].length > 1)
        .map(
          (m) =>
            '<div class="lvrow">' +
            data.levels[m]
              .map((t) => {
                const on = picks.get(m)!.has(t);
                return `<button type="button" data-m="${esc(m)}" data-t="${esc(t)}" class="${on ? 'on' : ''}" aria-pressed="${on}"><span class="model">${esc(short(m))}</span><span class="think">${esc(t)}</span></button>`;
              })
              .join('') +
            '</div>'
        )
        .join('');
      $('clear').hidden = picks.size === 0;
      renderAll();
    }

    $('picks').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.id === 'clear') picks.clear();
      else if (picks.has(b.dataset.model!)) picks.delete(b.dataset.model!);
      else picks.set(b.dataset.model!, new Set());
      syncPicks();
    });
    $('levels').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      const s = picks.get(b.dataset.m!)!;
      if (s.has(b.dataset.t!)) s.delete(b.dataset.t!);
      else s.add(b.dataset.t!);
      syncPicks();
    });
    $<HTMLInputElement>('q').addEventListener('input', (e) => {
      q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      renderAll();
    });
    $<HTMLInputElement>('rate').addEventListener('input', (e) => {
      rate = +(e.target as HTMLInputElement).value;
      $('rateval').textContent = '$' + rate.toFixed(2);
      renderAll();
    });
    $<HTMLInputElement>('onlybest').addEventListener('change', (e) => {
      onlyBest = (e.target as HTMLInputElement).checked;
      renderAll();
    });

    for (const t of data.tracks) {
      const section = $<HTMLElement>('track-' + t.id);
      section.querySelector('thead')!.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>('button[data-key]');
        if (!b) return;
        const key = b.dataset.key as SortKey;
        const cur = sorts.get(t.id) ?? DEFAULT_SORT;
        sorts.set(t.id, { key, dir: cur.key === key ? (-cur.dir as 1 | -1) : -1 });
        renderTrack(t);
      });
      const tbody = section.querySelector('tbody')!;
      const toggle = (tr: HTMLTableRowElement) => {
        const set = open.get(t.id) ?? new Set<string>();
        open.set(t.id, set);
        const id = tr.dataset.id!;
        const isOpen = !set.has(id);
        if (isOpen) set.add(id);
        else set.delete(id);
        tr.classList.toggle('open', isOpen);
        tr.setAttribute('aria-expanded', String(isOpen));
        (tr.nextElementSibling as HTMLElement).hidden = !isOpen;
      };
      tbody.addEventListener('click', (e) => {
        const tr = (e.target as Element).closest<HTMLTableRowElement>('tr.row');
        if (tr) toggle(tr);
      });
      tbody.addEventListener('keydown', (e) => {
        const tr = (e.target as Element).closest<HTMLTableRowElement>('tr.row');
        if (tr && (e.key === 'Enter' || e.key === ' ')) {
          e.preventDefault();
          toggle(tr);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .bench {
    --b95: #2f6b3f;
    --b85: #5d6d1c;
    --b75: #8a6300;
    --b60: #a2501d;
    --b0: #9e2b1f;
    --bnone: #8a8172;
  }
  html.dark .bench {
    --b95: #7cc58f;
    --b85: #b9cc6a;
    --b75: #e0b054;
    --b60: #e39463;
    --b0: #ef8b7b;
    --bnone: #7d7464;
  }
  .bench .mono,
  .bench .model,
  .bench td.num,
  .bench td.date {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .bench .model {
    font-size: 13px;
  }
  .bench .muted {
    color: var(--ink-2);
  }
  .bench .think {
    margin-left: 6px;
    padding: 0 6px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bench .value {
    margin-left: 6px;
    padding: 0 6px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bench .fail {
    margin-left: 6px;
    color: var(--b0);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bench .path {
    display: block;
    color: var(--ink-2);
    font-size: 12px;
  }

  /* Summary strip */
  .bench .summary {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  .bench .sumcard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    transition: background 0.2s;
  }
  .bench .sumcard:hover {
    background: var(--paper-2);
  }
  .bench .sumtop {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .bench .sumtop .model,
  .bench .sumpick .model {
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bench .grade {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bench .sumpick {
    font-size: 12px;
    border-top: 1px dashed var(--rule);
    padding-top: 6px;
  }
  .bench .sumpick .lbl {
    display: block;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bench .sumpick .think {
    margin-left: 0;
  }

  /* Controls */
  .bench .picks,
  .bench .lvrow {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bench .picks button,
  .bench .levels button {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
  }
  .bench .picks button:hover,
  .bench .levels button:hover {
    border-color: var(--ink-2);
  }
  .bench .picks button.on,
  .bench .levels button.on {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .bench .levels button.on .think {
    color: var(--paper);
    border-color: var(--paper);
  }
  .bench .picks .clear {
    color: var(--accent);
    border-color: var(--accent);
    font-family: var(--font-display);
    font-size: 12px;
  }
  .bench .count {
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.7;
  }
  .bench .levels:not(:empty) {
    margin-top: 10px;
    display: grid;
    gap: 6px;
  }
  .bench .q input {
    width: 100%;
    margin-top: 14px;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }
  .bench .q input:focus {
    outline: none;
    border-color: var(--ink-2);
  }
  .bench .ratebox {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 18px 0 8px;
    padding: 12px 16px;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }
  .bench .rate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 14px;
  }
  .bench .rate input {
    flex: 1;
    max-width: 280px;
    accent-color: var(--accent);
  }
  .bench .only {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 13px;
    cursor: pointer;
  }
  .bench .only input {
    accent-color: var(--accent);
  }
  .bench .ratehelp {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* Tracks */
  .bench section.track {
    margin-top: 3rem;
    padding-top: 2rem;
    scroll-margin-top: 9rem;
  }
  .bench .trackhead {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .bench .trackhead {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }
  .bench .what {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .bench details.tasks {
    margin: 8px 0;
    font-size: 14px;
  }
  .bench details.tasks summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .bench details.tasks ul {
    margin: 8px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--rule);
  }
  .bench details.tasks li {
    margin: 4px 0;
    color: var(--ink-2);
  }
  .bench details.tasks .mono {
    color: var(--ink);
    font-weight: 600;
    margin-right: 6px;
  }
  .bench .method {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .bench .chart svg {
    width: 100%;
    height: auto;
  }
  .bench .chart .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .bench .chart .tick,
  .bench .chart .axis {
    fill: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .bench .chart .axis {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .bench .chart .dot {
    fill-opacity: 0.75;
  }
  .bench .chart .pick {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 2;
  }

  /* Tables */
  .bench .table-scroll {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .bench table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .bench th,
  .bench td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .bench th {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .bench th button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .bench th[aria-sort='descending'] button::after {
    content: ' ↓';
    color: var(--accent);
  }
  .bench th[aria-sort='ascending'] button::after {
    content: ' ↑';
    color: var(--accent);
  }
  .bench .num {
    text-align: right;
  }
  .bench td.num,
  .bench td.date {
    font-size: 13px;
    white-space: nowrap;
  }
  .bench .date {
    text-align: right;
    color: var(--ink-2);
  }
  .bench tr.row {
    cursor: pointer;
  }
  .bench tr.row:hover,
  .bench tr.row:focus-visible {
    background: var(--paper-2);
    outline: none;
  }
  .bench tr.row.best {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .bench tr.row.open td {
    border-bottom: 0;
  }
  .bench tr.detail > td {
    padding: 0 10px 12px 24px;
  }
  .bench tr.empty td {
    color: var(--ink-2);
    font-style: italic;
  }
  .bench .subs {
    display: block;
