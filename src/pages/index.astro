---
import { getEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site-config';
import { PERSON_ID, webPage } from '../utils/schema';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Missing site/home content');
const h = home.data as any;
const { Content } = await render(home);

const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const tooling = allWork.filter((w) => w.data.tooling).slice(0, 3);
const cases = allWork.filter((w) => w.data.featured).slice(0, 3);
const posts = (await getCollection('writing'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 5);

const words: string[] = String(h.title).split(/\s+/);

const pad = (n: number) => String(n).padStart(2, '0');
const fmtDate = (d: string | Date) => {
  const x = new Date(d);
  return `${x.getUTCFullYear()}.${pad(x.getUTCMonth() + 1)}.${pad(x.getUTCDate())}`;
};
const blurbFor = (p: (typeof posts)[number]) => {
  const d = (p.data as any).description as string | undefined;
  if (d) return d;
  const text = (p.body ?? '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*_>`]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > 140 ? text.slice(0, 140).trimEnd() + '…' : text;
};
---

<BaseLayout
  description={siteConfig.description}
  image={siteConfig.image}
  title="Product & Operations Consultant"
  schema={[
    webPage('ProfilePage', '/', 'Soham Adwani', siteConfig.description, {
      mainEntity: { '@id': PERSON_ID }
    })
  ]}
>
  <div class="container-main">
    <!-- a. Typographic spread -->
    <section class="grid-main gap-y-8 pt-16 pb-16 sm:pt-28 sm:pb-24">
      <div class="[grid-column:1/13]">
        <h1 class="headline">
          {
            words.map((w, i) => (
              <span class="reveal inline-block mr-[0.25em]" style={`--i:${i}`}>
                {w}
              </span>
            ))
          }
        </h1>
        <p class="subhead mt-8 max-w-xl reveal" style={`--i:${words.length}`}>{h.subhead}</p>
      </div>
    </section>

    <!-- b. About -->
    <section class="rule grid-main gap-y-8 pt-10 pb-20 sm:pb-28">
      <div class="[grid-column:1/8] prose-main reveal">
        <Content />
      </div>
      <div class="[grid-column:9/13] reveal" style="--i:1">
        <a class="link font-display font-medium text-[11px] uppercase tracking-[0.08em]" href={h.buttonPath}>{h.buttonText} →</a>
      </div>
    </section>

    <!-- c. 2026: The year of tooling -->
    <section class="pb-20 sm:pb-28">
      <p class="eyebrow mb-6 reveal">2026: The year of tooling</p>
      <div class="rule grid grid-cols-1 gap-x-6 gap-y-10 pt-8 md:grid-cols-3">
        {
          tooling.map((item, i) => {
            const site = item.data.url ?? item.data.site;
            const ctas = [
              site && { label: 'Visit the site ↗', href: site, external: true },
              item.data.demo && { label: 'Try the demo ↗', href: item.data.demo, external: true },
              !item.data.url && { label: 'Read the case study →', href: `/work/${item.id}`, external: false }
            ].filter(Boolean) as { label: string; href: string; external: boolean }[];
            return (
              <div class="reveal" style={`--i:${i + 1}`}>
                {item.data.logo && (
                  <a href={ctas[0]?.href} target={ctas[0]?.external ? '_blank' : undefined} rel={ctas[0]?.external ? 'noopener noreferrer' : undefined} class="photo block aspect-square mb-5" transition:name={`work-${item.id}`}>
                    <Image src={item.data.logo} alt={item.data.listingTitle} width={600} class="vintage develop h-full w-full object-cover" />
                  </a>
                )}
                <h3 class="headline-sm mb-3">{item.data.listingTitle}</h3>
                <p class="text-ink-2">{item.data.blurb}</p>
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                  {ctas.map((c) => (
                    <a class="link font-display font-medium text-[11px] uppercase tracking-[0.08em]" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
                      {c.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- d. Case Studies from a past life -->
    <section class="pb-20 sm:pb-28">
      <p class="eyebrow mb-6 reveal">Case Studies from a past life</p>
      <div class="rule grid grid-cols-1 gap-x-6 gap-y-10 pt-8 md:grid-cols-3">
        {
          cases.map((item, i) => (
            <a href={item.data.url ?? `/work/${item.id}`} class="work-card reveal block" style={`--i:${i + 1}`}>
              {item.data.logo && (
                <div class="photo aspect-square mb-5" transition:name={`work-${item.id}`}>
                  <Image src={item.data.logo} alt={item.data.listingTitle} width={600} class="vintage develop h-full w-full object-cover" />
                </div>
              )}
              <h3 class="headline-sm mb-3">
                {item.data.listingTitle} <span class="arrow inline-block transition-transform duration-300">→</span>
              </h3>
              <p class="text-ink-2">{item.data.blurb}</p>
            </a>
          ))
        }
      </div>
      <div class="rule mt-10 pt-6">
        <a class="link font-display font-medium text-[11px] uppercase tracking-[0.08em]" href="/work">All work →</a>
      </div>
    </section>

    <!-- e. Writing -->
    <section class="pb-8">
      <p class="eyebrow mb-6 reveal">Writing</p>
      {
        posts.map((p, i) => (
          <a href={`/writing/${p.id}`} class="post-row rule grid-main gap-y-2 py-5 reveal block" style={`--i:${i + 1}`}>
            <p class="eyebrow [grid-column:1/3] pt-2">{fmtDate(p.data.date)}</p>
            <h3
              class="font-display font-medium text-[24px] leading-tight tracking-tight [grid-column:3/10]"
              transition:name={`post-${p.id}`}
            >
              {p.data.title}
            </h3>
            <p class="hidden md:block text-ink-2 text-[15px] leading-snug [grid-column:10/13]">{blurbFor(p)}</p>
          </a>
        ))
      }
      <div class="rule pt-6">
        <a class="link font-display font-medium text-[11px] uppercase tracking-[0.08em]" href="/writing">All writing →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .subhead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .work-card:hover .arrow {
    transform: translateX(6px);
  }
  .work-card:hover h3,
  .post-row:hover h3 {
    color: var(--accent);
  }
</style>
