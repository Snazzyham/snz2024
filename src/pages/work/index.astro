---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbs, itemList, webPage } from '../../utils/schema';

const portfolio = (await getEntry('site', 'portfolio'))!.data;
const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={portfolio.title ?? 'Work'}
  description="Selected case studies and projects by Soham Adwani."
  schema={[
    webPage('CollectionPage', '/work/', portfolio.title ?? 'Work', 'Selected case studies and projects by Soham Adwani.', {
      mainEntity: itemList(cases.map((c) => ({ name: c.data.listingTitle, path: `/work/${c.id}/` })))
    }),
    breadcrumbs([{ name: 'Work', path: '/work/' }])
  ]}
>
  <div class="container-main pt-12 pb-24 sm:pt-20">
    <header class="grid-main mb-16 sm:mb-24">
      <h1 class="headline reveal" style="grid-column: 1 / span 8">{portfolio.title}</h1>
      <p class="standfirst reveal mt-6" style="--i:2; grid-column: 1 / span 7">
        Campaigns and products, a few of which won things.
      </p>
    </header>

    {
      cases.map((c, i) => {
        const img = c.data.hero ?? c.data.logo;
        const odd = i % 2 === 0;
        return (
          <section class="rule grid-main items-end py-10 sm:py-16">
            {img && (
              <a
                href={`/work/${c.id}`}
                class={`photo reveal block aspect-[4/5] ${c.data.hero ? '' : 'logo-plate'} ${odd ? 'spread-left' : 'spread-right'}`}
                aria-label={c.data.listingTitle}
              >
                <Image
                  src={img}
                  alt={c.data.listingTitle}
                  width={900}
                  class="vintage develop h-full w-full object-cover"
                  transition:name={`work-${c.id}`}
                />
              </a>
            )}
            <div
              class={`reveal flex flex-col gap-5 ${odd ? 'text-right-side' : 'text-left-side'}`}
              style="--i:2"
            >
              <p class="eyebrow">
                {c.data.client} <span class="text-accent">·</span> No. {pad(i + 1)}
              </p>
              <h2 class="headline-sm">
                <a href={`/work/${c.id}`}>{c.data.listingTitle}</a>
              </h2>
              <p class="max-w-md">{c.data.blurb}</p>
              <a
                href={`/work/${c.id}`}
                class="link font-display font-medium text-xs tracking-[0.08em] uppercase"
              >
                Read the case →
              </a>
            </div>
          </section>
        );
      })
    }

    {
      portfolio.other && portfolio.other.length > 0 && (
        <section class="mt-16 sm:mt-24">
          <p class="eyebrow reveal mb-6">{portfolio.otherTitle}</p>
          <ul>
            {portfolio.other.map((o, i) => (
              <li class="rule reveal" style={`--i:${i % 5}`}>
                <a
                  href={o.url}
                  target={o.internal ? undefined : '_blank'}
                  rel={o.internal ? undefined : 'noopener noreferrer'}
                  class="ledger-row grid-main group items-baseline py-5"
                >
                  <span class="font-display text-xl font-medium tracking-tight">
                    {o.title}
                    {!o.internal && (
                      <span class="font-display font-medium text-sm text-ink-2 transition-colors group-hover:text-accent">
                        {' '}
                        ↗
                      </span>
                    )}
                  </span>
                  <span class="text-ink-2">{o.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Client logos are small source files; show them as a centred mark on a plate, not a full-bleed photo. */
  .logo-plate { display: grid; place-items: center; }
  .logo-plate :global(img) { width: 42%; height: auto; object-fit: contain; }
  @media (min-width: 768px) {
    .spread-left { grid-column: 1 / span 6; grid-row: 1; }
    .spread-right { grid-column: 7 / span 6; grid-row: 1; }
    .text-right-side { grid-column: 8 / span 5; grid-row: 1; }
    .text-left-side { grid-column: 1 / span 5; grid-row: 1; }
    .ledger-row > :first-child { grid-column: 1 / span 5; }
    .ledger-row > :last-child { grid-column: 6 / span 7; }
  }
</style>
