---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { abs, author, breadcrumbs, webPage } from '../../utils/schema';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] }
  }));
}

const { post, newer, older } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const body = post.body ?? '';
const plain = body
  .replace(/<[^>]*>/g, ' ')
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#*_>`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const minutes = Math.max(1, Math.round(plain.split(' ').length / 230));
const dateStr = data.date.toISOString().slice(0, 10).replaceAll('-', '.');
const url = new URL(`/writing/${post.id}/`, Astro.site ?? Astro.url).toString();
const description = data.description ?? plain.slice(0, 155);
const schema = [
  webPage('WebPage', `/writing/${post.id}/`, data.seoTitle ?? data.title, description),
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: data.title,
    description,
    datePublished: data.date.toISOString().slice(0, 10),
    ...(data.image ? { image: abs(data.image.src) } : {}),
    wordCount: plain.split(' ').length,
    author,
    publisher: author,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    url
  },
  breadcrumbs([
    { name: 'Writing', path: '/writing/' },
    { name: data.title, path: `/writing/${post.id}/` }
  ])
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={description}
  image={data.image ? { src: data.image.src, alt: data.title } : undefined}
  pageType="article"
  schema={schema}
>
  <article class="container-main pt-12 pb-24 sm:pt-20">
    <header class="mb-12 sm:mb-16">
      <p class="eyebrow reveal mb-5">
        {dateStr} <span class="text-accent">·</span>
        {minutes} min read
      </p>
      <h1
        class="headline reveal"
        style="--i:1; max-width: 62rem"
        transition:name={`post-${post.id}`}
      >
        {data.title}
      </h1>
      {
        data.description && (
          <p class="standfirst reveal mt-6 max-w-2xl" style="--i:2">
            {data.description}
          </p>
        )
      }
    </header>

    {
      data.image && (
        <div class="photo reveal mb-14 w-full sm:mb-20" style="--i:2">
          <Image
            src={data.image}
            alt={data.title}
            width={1600}
            class="vintage develop block h-auto w-full"
          />
        </div>
      )
    }

    <div class="grid-main items-start">
      <div class="prose-main body-col">
        <Content />
      </div>
      <aside
        class="meta-col font-display font-medium text-xs tracking-[0.08em] uppercase"
      >
        <dl>
          <div class="rule py-3">
            <dt class="eyebrow mb-1">Date</dt>
            <dd>{dateStr}</dd>
          </div>
          <div class="rule py-3">
            <dt class="eyebrow mb-1">Read</dt>
            <dd>{minutes} min</dd>
          </div>
          <div class="rule py-3">
            <button type="button" class="copy-url-button link uppercase" data-url={url}>
              Copy link
            </button>
          </div>
        </dl>
      </aside>
    </div>

    <nav class="rule mt-24 grid-main pt-6 font-display font-medium text-xs tracking-[0.08em] uppercase">
      <div class="pn-newer">
        {
          newer && (
            <a href={`/writing/${newer.id}`} class="group block">
              <span class="eyebrow block">← Newer</span>
              <span class="font-display mt-1 block text-lg font-medium normal-case tracking-tight group-hover:text-accent">
                {newer.data.title}
              </span>
            </a>
          )
        }
      </div>
      <div class="pn-older">
        {
          older && (
            <a href={`/writing/${older.id}`} class="group block">
              <span class="eyebrow block">Older →</span>
              <span class="font-display mt-1 block text-lg font-medium normal-case tracking-tight group-hover:text-accent">
                {older.data.title}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .body-col { grid-column: 1 / span 7; }
    .meta-col { grid-column: 10 / span 3; position: sticky; top: 6rem; }
    .pn-newer { grid-column: 1 / span 6; }
    .pn-older { grid-column: 7 / span 6; }
  }
  @media (max-width: 767px) {
    .pn-older { margin-top: 1.5rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('.copy-url-button');
    btn?.addEventListener('click', async () => {
      const label = btn.innerText;
      await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
      btn.innerText = 'Copied';
      setTimeout(() => (btn.innerText = label), 2500);
    });
  });
</script>
