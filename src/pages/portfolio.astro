---
import type { PrismicItem, CaseStudy, PrismicData, PortfolioPageData } from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import CasePreview from '../components/CasePreview.astro';
import { getCases, getPage } from '../prismic';
import * as prismic from '@prismicio/client';

const cases = (await getCases()) as PrismicItem[];
const portfolioPageMain = (await getPage('portfolio_page')) as any as PrismicData;

const portfolioContent = portfolioPageMain.results[0] as PrismicItem;
const pd = portfolioContent.data as PortfolioPageData;
---

<BaseLayout title="Portfolio" description="Explore a diverse portfolio showcasing my passion and expertise" showHeader={false}>
  <h1 class="mb-16 text-4xl leading-tight font-heading sm:mb-24 sm:text-6xl tracking-tight font-black">{prismic.asText(pd.title)}</h1>

  <div class="mb-32">
    <div class="flex items-center gap-4 mb-12">
      <h2 class="font-heading text-sm uppercase tracking-[0.3em] font-bold opacity-30 whitespace-nowrap">{pd.case_study_title}</h2>
      <div class="h-px w-full bg-main opacity-10"></div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {
        cases.map((item: PrismicItem) => (
          <CasePreview
            slug={item.uid}
            client={(item.data as CaseStudy).client}
            clientLogo={(item.data as CaseStudy).client_logo.url || '-'}
            title={(item.data as CaseStudy).listing_title}
            blurb={(item.data as CaseStudy).listing_blurb}
            primary={(item.data as CaseStudy).primary}
            secondary={(item.data as CaseStudy).secondary}
          />
        ))
      }
    </div>
  </div>

  <div class="mb-32">
    <div class="flex items-center gap-4 mb-12">
      <h2 class="font-heading text-sm uppercase tracking-[0.3em] font-bold opacity-30 whitespace-nowrap">{pd.portfolio_items_title}</h2>
      <div class="h-px w-full bg-main opacity-10"></div>
    </div>
    
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-16">
      {
        pd.portfolio_items.map((item) => (
          <div class="group hover:opacity-70 transition-all">
            <a href={item.value} target="_blank" rel="noreferrer">
              <h3 class="font-heading text-xl tracking-tight mb-2 group-hover:italic transition-all">{item.key}</h3>
              <p class="prose prose-dante font-light text-sm opacity-60 leading-relaxed">{item.desc}</p>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
